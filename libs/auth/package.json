{
  "name": "@wib/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./edge": {
      "types": "./src/edge.ts",
      "import": "./src/edge.ts",
      "default": "./src/edge.ts"
    },
    "./config": {
      "types": "./src/lib/auth.config.ts",
      "import": "./src/lib/auth.config.ts",
      "default": "./src/lib/auth.config.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@wib/config": "workspace:*",
    "@wib/db": "workspace:*",
    "@wib/domain": "workspace:*",
    "next-auth": "5.0.0-beta.32",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  }
}
