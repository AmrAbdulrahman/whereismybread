# Copy to .env.local and fill in. .env.local is git-ignored.
# In preview/production these are set in the Vercel project settings;
# the Vercel x Supabase and Vercel Blob integrations inject their own.

# --- Database (Supabase Postgres) ---
# Pooled connection (PgBouncer, transaction mode) for app runtime.
POSTGRES_URL=
# Direct connection (:5432) for drizzle-kit migrations only.
POSTGRES_URL_NON_POOLING=

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# --- Transactional email (Resend) ---
RESEND_API_KEY=
# Dev: onboarding@resend.dev is Resend's shared sandbox sender. It only
# delivers to the email address of the Resend account that owns the key.
# Preview/prod: switch to an address on a domain verified in Resend.
EMAIL_FROM="Where's My Money <onboarding@resend.dev>"

# --- Rate limiting (Vercel KV / Upstash) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Build identity (set automatically on Vercel; only needed locally) ---
# NEXT_PUBLIC_BUILD_ID=local

# Set to 1 to skip env validation (CI builds/typechecks that don't need real values).
# SKIP_ENV_VALIDATION=1
