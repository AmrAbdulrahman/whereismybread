# Copy to .env.local and fill in. .env.local is git-ignored.
# In preview/production these are set in the Vercel project settings;
# the Vercel x Supabase and Vercel Blob integrations inject their own.

# --- Database (Supabase Postgres) ---
# Pooled connection (PgBouncer, transaction mode) for app runtime.
POSTGRES_URL=
# Direct connection (:5432) for drizzle-kit migrations only.
POSTGRES_URL_NON_POOLING=

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# --- Transactional email (Resend) ---
RESEND_API_KEY=
# Dev: onboarding@resend.dev is Resend's shared sandbox sender. It only
# delivers to the email address of the Resend account that owns the key.
# Preview/prod: switch to an address on a domain verified in Resend.
EMAIL_FROM="Where Is My Bread <onboarding@resend.dev>"

# --- Rate limiting (Vercel KV / Upstash) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Scheduled bank sync ---
# Shared secret for manual triggers: GET /api/bank-sync/enable-banking with
# `Authorization: Bearer <CRON_SECRET>`. openssl rand -hex 32
CRON_SECRET=
# QStash drives the recurring sync (every 5 min). The signing keys verify the
# `Upstash-Signature` on each scheduled POST; the token + url are only needed to
# create/inspect the schedule via scripts/qstash-schedule.mjs. From the QStash
# console: https://console.upstash.com/qstash
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io

# --- Web Push (browser notifications) ---
# Generate a VAPID key pair: npx web-push generate-vapid-keys
# Public key must be set in BOTH vars (the NEXT_PUBLIC_ one reaches the browser).
# Leave blank to disable push — the app still records in-app notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# A mailto: or https URL identifying the sender to the push service.
VAPID_SUBJECT=mailto:support@whereismybread.app

# --- Build identity (set automatically on Vercel; only needed locally) ---
# NEXT_PUBLIC_BUILD_ID=local

# Set to 1 to skip env validation (CI builds/typechecks that don't need real values).
# SKIP_ENV_VALIDATION=1
